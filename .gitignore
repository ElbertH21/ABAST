# ─────────────────────────────────────────────────────────────
# ABAST attacker-side repo — .gitignore
# results/ CSVs are intentionally TRACKED. Do not add *.csv here.
# ─────────────────────────────────────────────────────────────

# Data (gitignored — see data/README.md to obtain / regenerate each subfolder)
/data/*
!/data/README.md

# Working / generated artifact trees left in place (see README)
/a2/
/outputs/
outputs/

# Third-party clones (each has its own .git; used in place, not committed).
# Balabit dataset = Mouse-Dynamics-Challenge/; upstream SapiAgent source = sapiagent/.
/Mouse-Dynamics-Challenge/
/sapiagent/

# Virtual environments
*.venv/
.venv/
venv/
env/
ENV/
sapiagent-venv/
attacker/dmtg/.venv/

# Model weights / large binaries
*.pt
*.pth
*.h5
*.keras
*.ckpt
*.npy
*.pkl

# A3 (DMTG) model checkpoints
attacker/dmtg/checkpoints/

# Python / Jupyter cruft
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor / OS / Windows / agent-local
.vscode/
.DS_Store
*:Zone.Identifier
*.log
.claude/
CLAUDE.md
